# Copie para .env e preencha. O .env não deve ser versionado.

# Obrigatório: chave longa e aleatória, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcional (padrão: sqlite:///tasks.db, gravado em instance/tasks.db)
# DATABASE_URL=sqlite:///tasks.db

# Validade do token de login, em segundos (padrão: 28800 = 8h)
# TOKEN_MAX_AGE=28800

# Origens liberadas para CORS, separadas por vírgula (vazio = CORS desligado)
# CORS_ORIGINS=http://localhost:3000

# Servidor de desenvolvimento (padrão: debug desligado, só localhost)
# FLASK_DEBUG=false
# HOST=127.0.0.1
# PORT=5000

# SMTP para NotificationService (sem isso o envio é ignorado)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
