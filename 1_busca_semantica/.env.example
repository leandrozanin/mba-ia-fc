# Gere uma chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=coloque_sua_chave_aqui

# Modelos usados para gerar embeddings e respostas.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini

# O caminho relativo é resolvido a partir desta pasta.
PDF_PATH=./document.pdf

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=busca_semantica
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/busca_semantica
PGVECTOR_COLLECTION=pdf_busca_semantica
